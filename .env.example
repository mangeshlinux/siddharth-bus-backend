# Environment Variables — Siddharth School Bus & Travels Backend
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/siddharth-bus-db?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=siddharth-bus-jwt-secret-change-this-in-production

# Owner Authentication
OWNER_PIN=0081
OWNER_SECRET_PASS=siddharth2026

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
